<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Builds the deployments of a CKomposable solution (the "Deployment" folder next to its central "ckonf.json"): one generated builder and host per deployed App, published in the assets of the release. Called by "Deployment/GenerateAssets.cs".</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CK.AppBuilder.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CK.Engine.Configuration" Version="36.0.2-0.uc.0.ci.46" />
  </ItemGroup>
</Project>
